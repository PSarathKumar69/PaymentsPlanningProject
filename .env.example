GEMINI_API_KEY=your-gemini-api-key-here

# Postgres connection string (Neon pooled -pooler endpoint in production).
# Unset locally to fall back to SQLite via PAYMENTS_DB_PATH below.
DATABASE_URL=postgres://user:password@host/dbname

# Local SQLite fallback path, only used when DATABASE_URL is unset.
PAYMENTS_DB_PATH="backend/db/app.db"