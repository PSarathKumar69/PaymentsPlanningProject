# Production env vars (AWS App Runner or any real deployment target).
# Copy this file's guidance into App Runner's environment-variable config —
# don't put real secrets in this file itself, and don't commit real values.
# Confirmed against a real local Postgres run (2026-08): login, Excel
# upload/ingestion, Master Data grid, and password change all work
# end-to-end with exactly these variables set.

# Postgres connection string (RDS in production). Once set, this switches
# the app out of local-SQLite dev mode: EXCEL_PATH moves to a /tmp-backed
# path (backend/ingestion/load_excel.py) that re-materializes from the
# MasterExcelBlob table in Postgres on every cold start — verified this
# survives a simulated container restart with the Excel and all vendor
# rows intact.
DATABASE_URL=postgresql://<user>:<password>@<rds-endpoint>:5432/<dbname>

# Required the moment DATABASE_URL is set — the app refuses to start
# without it in that case (backend/auth/security.py). Use a long random
# value, e.g. `openssl rand -hex 32`. Store this in App Runner's secrets
# config, not as a plain env var, if your account setup allows it.
JWT_SECRET_KEY=<generate-a-long-random-string>

# Only needed for the AI-assisted column-mapping step on Excel upload
# (backend/ai_layer/gemini_client.py) — login and everything else work
# without it, but Finance's real upload flow needs it set.
GEMINI_API_KEY=<your-real-gemini-api-key>

# Auto-enabled whenever DATABASE_URL is set (assumes HTTPS-worthy prod) —
# only set this explicitly if you need to override that default.
# COOKIE_SECURE=true

# Not needed once DATABASE_URL is set (local-SQLite dev only) — left here
# for reference, not for production use.
# PAYMENTS_DB_PATH=/app/backend/db/app.db
