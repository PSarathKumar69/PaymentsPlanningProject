# Secrets: never commit these. Real values live in a local .env file
# (docker compose reads it automatically) or your shell environment —
# .env.example documents what's needed, with placeholders only.
.env
.env.*
!.env.example

# Python
**/__pycache__/
**/*.pyc
.pytest_cache/
.venv/
venv/
*.egg-info/

# Local SQLite dev DB + one-off backup snapshots
backend/db/*.db
backend/db/*.db.backup_*
backend/db/*.bak-erpfix-*

# Frontend build artifacts
frontend/node_modules/
frontend/dist/
frontend/.vite/
