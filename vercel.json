{
  "services": {
    "backend": {
      "root": ".",
      "entrypoint": "backend.api.main:app",
      "functions": {
        "backend/api/main.py": {
          "excludeFiles": "{frontend/**,test_data/**,data/**,backend/db/*.db*,**/__pycache__/**,**/*.pyc,.pytest_cache/**,**/test_*.py,**/*_test.py}"
        }
      }
    },
    "frontend": {
      "root": "frontend/"
    }
  },
  "rewrites": [
    {
      "source": "/(ai|analytics|audit-log|calendar|config|ingestion|master-data|models|payments|plan-allocations|plan-runs|vendors|weekly-view|static)(/.*)?",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
